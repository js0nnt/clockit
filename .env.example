# Optional. Clockit has its own Spotify app built in, so visitors get a one-button
# "Connect Spotify" with nothing set here.
#
# Set this only if you deploy a copy against your own Spotify app
# (https://developer.spotify.com/dashboard) — for example so your copy has its own
# 25-user allowlist. It is read at build time, so a change needs a redeploy.
VITE_SPOTIFY_CLIENT_ID=

# Local development only. `vite dev` does not run the functions in api/, so settings
# sync is unavailable locally unless requests are forwarded to a deployment:
# CLOCKIT_API_TARGET=https://your-project.vercel.app
